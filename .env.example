FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json
FIREBASE_PROJECT_ID=rsvp-revamp
FIREBASE_DATABASE_ID=(default)
# Public Firebase web app configuration (not the Admin SDK credential)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=rsvp-revamp.firebaseapp.com
FIREBASE_WEB_APP_ID=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173/rsvp-gdg/
PUBLIC_BASE_URL=http://localhost:8000
EVENT_ID=devfest-lebanon-2026
EVENT_NAME=DevFest Lebanon 2026 — Be Part of It
REGISTRATION_DEADLINE=2026-12-31T23:59:59+02:00
FORCE_CLOSE_REGISTRATION=false
SUBMISSIONS_PER_HOUR=20
INVITATION_TTL_HOURS=48
# Generate strong, permanent secrets; do not rotate while tickets are active.
TICKET_SIGNING_KEY=
SHEETS_WEBHOOK_SECRET=
# One shared VIP code, stored only as its SHA-256 hash. Empty disables VIP submissions.
VIP_CODE_HASHES=[]
# Firebase handles sign-in emails in the frontend. These settings are ONLY for
# invitation/status/ticket email delivery; leave disabled until configured.
MAIL_PROVIDER=disabled
MAIL_FROM=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Optional Google Sheets synchronization
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Attendees
